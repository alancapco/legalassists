# Capco Contract Assists — copy to .env and fill in. NEVER commit .env.

# Capco Wayne AI (required for chat)
COPILOT_NAME="Capco Wayne"
API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
TEMPERATURE=0.2
MAX_TOKENS=2048

# Brave Search (optional — Assessment mode web research)
BRAVE_API_KEY=
BRAVE_SEARCH_ENABLED=true

# App
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_COPILOT_NAME="Capco Wayne"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
API_PORT=8000
WEB_PORT=3000
